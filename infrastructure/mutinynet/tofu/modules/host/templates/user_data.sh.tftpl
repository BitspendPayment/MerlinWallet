#!/bin/bash
# Bootstrap for the host-mode cosigner.
#
# Order matters in two places:
#   1. the data volume mounts before anything writes to it — a write to an
#      unmounted /mnt/data lands on the root disk and vanishes on the next
#      instance replacement, taking the sealed shares with it;
#   2. the unit files exist and daemon-reload has run before the first deploy,
#      because the deploy script ends in `systemctl restart`.

exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1
set -xeuo pipefail

REGION="${region}"
SSM_PREFIX="${ssm_prefix}"
BINARY_S3_URL="${binary_s3_url}"
DATA_VOLUME_ID="${data_volume_id}"
DATA_MOUNT="${data_mount}"
APP_PORT="${app_port}"
FQDN="${fqdn}"
ACME_EMAIL="${acme_email}"
CADDY_VERSION="${caddy_version}"
CADDY_SHA512="${caddy_sha512}"

# libcap provides setcap (used to let unprivileged Caddy bind 80/443).
dnf install -y jq tar libcap

# ---------------------------------------------------------------------------
# Data volume
# ---------------------------------------------------------------------------
# On Nitro instances EBS volumes surface as NVMe devices in attach order, so the
# /dev/sdf we asked for is not a real path. Resolve by volume ID instead: AWS
# puts the ID (dashes stripped) in the NVMe serial, which udev exposes by-id.
SERIAL="$(echo "$DATA_VOLUME_ID" | tr -d '-')"
BY_ID="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$SERIAL"

# The attachment is a separate API call that races instance boot.
for attempt in $(seq 1 60); do
  [[ -e "$BY_ID" ]] && break
  echo "waiting for data volume $DATA_VOLUME_ID (attempt $attempt)..."
  sleep 5
done

if [[ ! -e "$BY_ID" ]]; then
  echo "FATAL: data volume $DATA_VOLUME_ID never appeared" >&2
  exit 1
fi

DEV="$(readlink -f "$BY_ID")"

# Format ONLY when there is no filesystem. A volume reattached from a replaced
# instance already has one, and reformatting would destroy every wallet's
# server-side share — 2-of-2 means those wallets could never spend again.
if ! blkid "$DEV"; then
  echo "no filesystem on $DEV — formatting (first boot for this volume)"
  mkfs.ext4 -L cosigner-data "$DEV"
fi

mkdir -p "$DATA_MOUNT"
UUID="$(blkid -s UUID -o value "$DEV")"
if ! grep -q "$UUID" /etc/fstab; then
  echo "UUID=$UUID $DATA_MOUNT ext4 defaults,nofail 0 2" >> /etc/fstab
fi
mount -a
mountpoint -q "$DATA_MOUNT" || { echo "FATAL: $DATA_MOUNT not mounted" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Users and directories
# ---------------------------------------------------------------------------
id -u cosigner &>/dev/null || useradd --system --no-create-home --shell /sbin/nologin cosigner
id -u caddy    &>/dev/null || useradd --system --no-create-home --shell /sbin/nologin caddy

mkdir -p "$DATA_MOUNT/cosigner" "$DATA_MOUNT/caddy" /etc/cosigner
chown -R cosigner:cosigner "$DATA_MOUNT/cosigner"
chown -R caddy:caddy "$DATA_MOUNT/caddy"

# The env file holds the session-token secret and the FCM service account, so
# it is readable by the service user and nobody else.
chown root:cosigner /etc/cosigner
chmod 0750 /etc/cosigner

# ---------------------------------------------------------------------------
# Caddy (pinned version, verified digest)
# ---------------------------------------------------------------------------
if [[ ! -x /usr/local/bin/caddy ]]; then
  TARBALL="caddy_$${CADDY_VERSION}_linux_amd64.tar.gz"
  URL="https://github.com/caddyserver/caddy/releases/download/v$${CADDY_VERSION}/$${TARBALL}"
  curl -fsSL --retry 5 --retry-delay 5 -o "/tmp/$${TARBALL}" "$URL"

  # Pinned + checksummed rather than tracking a moving @latest.
  echo "$${CADDY_SHA512}  /tmp/$${TARBALL}" | sha512sum -c -

  tar -xzf "/tmp/$${TARBALL}" -C /tmp caddy
  install -m 0755 /tmp/caddy /usr/local/bin/caddy
  rm -f "/tmp/$${TARBALL}" /tmp/caddy
fi

# Bind 80/443 without running as root. Belt and braces with the unit's
# AmbientCapabilities: NoNewPrivileges=true makes the kernel IGNORE file
# capabilities, so this setcap alone leaves Caddy crash-looping on
# "bind: permission denied". The ambient capability is what actually works.
setcap cap_net_bind_service=+ep /usr/local/bin/caddy

# NOTE: this host does NOT serve /.well-known/assetlinks.json. The WebAuthn RP
# ID is vtxos.com, not this hostname, so Play Services fetches the association
# from https://vtxos.com/.well-known/assetlinks.json — which is already live and
# already covers this app. The RP ID is independent of the API hostname (regtest
# proves it: the server runs on 127.0.0.1 with RP ID vtxos.com).
cat > /etc/Caddyfile <<CADDYFILE
{
	email $${ACME_EMAIL}
	# Certs + ACME account key live on the data volume so an instance replace
	# reuses them instead of re-issuing. Let's Encrypt rate-limits duplicate
	# certificates (5/week), which a few redeploys would otherwise exhaust.
	storage file_system $${DATA_MOUNT}/caddy
}

$${FQDN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:$${APP_PORT}
}
CADDYFILE

cat > /etc/systemd/system/caddy.service <<'UNIT'
[Unit]
Description=Caddy (TLS termination for cosigner)
After=network-online.target
Wants=network-online.target

[Service]
User=caddy
Group=caddy
ExecStart=/usr/local/bin/caddy run --config /etc/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=5s

# Required to bind 80/443 as the unprivileged `caddy` user. File capabilities
# (the setcap above) are ignored under NoNewPrivileges=true; ambient caps are
# set by systemd before execve and survive it, so they are what grants the
# privilege. Without this Caddy crash-loops on "bind: permission denied".
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
UNIT

# ---------------------------------------------------------------------------
# Runtime config from SSM
# ---------------------------------------------------------------------------
# Re-run at every boot and every redeploy, so changing config is an SSM write
# plus a restart — never a rebuild. --with-decryption covers the SecureStrings.
#
# `@sh` single-quotes each value, which systemd's EnvironmentFile parser
# understands. Values are single-line by construction (terraform strips CR/LF
# before writing them to SSM) because EnvironmentFile has no line-continuation.
cat > /usr/local/sbin/cosigner-env.sh <<ENVSCRIPT
#!/bin/bash
set -euo pipefail
umask 077
TMP="\$(mktemp)"
aws ssm get-parameters-by-path \
  --path "$${SSM_PREFIX}/env" \
  --with-decryption \
  --recursive \
  --region "$${REGION}" \
  --query 'Parameters[].[Name,Value]' \
  --output json \
  | jq -r '.[] | "\(.[0] | split("/") | last)=\(.[1] | @sh)"' > "\$TMP"
chown root:cosigner "\$TMP"
chmod 0640 "\$TMP"
mv "\$TMP" /etc/cosigner/env
ENVSCRIPT
chmod 0755 /usr/local/sbin/cosigner-env.sh

# ---------------------------------------------------------------------------
# Deploy script — also the in-place redeploy entry point (SSM send-command)
# ---------------------------------------------------------------------------
# Download to a temp name and rename, so a partial download can never leave a
# truncated binary at the path systemd execs.
cat > /usr/local/sbin/cosigner-deploy.sh <<DEPLOY
#!/bin/bash
set -euo pipefail
aws s3 cp "$${BINARY_S3_URL}" /usr/local/bin/cosigner.new --region "$${REGION}"
chmod 0755 /usr/local/bin/cosigner.new
mv /usr/local/bin/cosigner.new /usr/local/bin/cosigner
/usr/local/sbin/cosigner-env.sh
systemctl restart cosigner
DEPLOY
chmod 0755 /usr/local/sbin/cosigner-deploy.sh

# RequiresMountsFor implies both Requires= and After= on the mount unit, so the
# service can never start against an unmounted data directory.
cat > /etc/systemd/system/cosigner.service <<UNIT
[Unit]
Description=MPC cosigner
After=network-online.target
Wants=network-online.target
RequiresMountsFor=$${DATA_MOUNT}

[Service]
User=cosigner
Group=cosigner
EnvironmentFile=/etc/cosigner/env
ExecStart=/usr/local/bin/cosigner --port $${APP_PORT}
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=$${DATA_MOUNT}/cosigner

[Install]
WantedBy=multi-user.target
UNIT

# ---------------------------------------------------------------------------
# Start
# ---------------------------------------------------------------------------
# daemon-reload BEFORE the first deploy: cosigner-deploy.sh ends in
# `systemctl restart cosigner`, which needs the unit to already exist.
systemctl daemon-reload
systemctl enable caddy cosigner
systemctl start caddy

# IAM is eventually consistent and the instance profile can land after boot, so
# both the S3 read and the SSM read may 403 for the first few seconds.
deployed=0
for attempt in $(seq 1 10); do
  if /usr/local/sbin/cosigner-deploy.sh; then
    deployed=1
    break
  fi
  echo "deploy failed (attempt $attempt), waiting for IAM propagation..."
  sleep 10
done

if [[ "$deployed" -ne 1 ]]; then
  echo "FATAL: could not deploy the runtime after 10 attempts" >&2
  exit 1
fi

echo "bootstrap complete: https://$${FQDN}"
